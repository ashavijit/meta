# Application metadata
@app
name:string EnvX
version:float 1.4
debug:bool true
tags:list [prod,backend,secure]

# Database configuration
@database
host:string localhost
port:int 5432
username:string $ENV(DB_USER, "admin")
password:env $ENV(DB_PASS)
max_connections:int 100

# Cache setup
@cache
enabled:bool true
engine:string redis
# Simplified cache config for compatibility
host:string localhost
port:int 6379
timeout:int 30

# Feature toggles
@features
auth:bool true
analytics:bool false